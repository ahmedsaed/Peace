{
  "expo": {
    "name": "Peace",
    "slug": "peace",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "peace",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17140F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ahmed.peace",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17140F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Peace uses the camera to photograph a receipt and keep it with the record.",
          "photosPermission": "Peace can attach a photo you have already taken to a record."
        }
      ],
      "expo-document-picker",
      "@react-native-community/datetimepicker",
      "./plugins/with-dark-theme",
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
