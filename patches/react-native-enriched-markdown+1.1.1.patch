+  // [peace patch] The coin: an accent disc, a darker rim, a glint. Its opacity
+  // follows a slow cosine (1.3 s a breath) so it reads as "still writing"
+  // without pulling the eye off the words.
+  private val cursorPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+  private fun drawCursor(
+    canvas: Canvas,
+    style: CursorStyle,
+    x: Float,
+    y: Int,
+  ) {
+    val size = height.toFloat()
+    val phase = (android.os.SystemClock.uptimeMillis() % CURSOR_PERIOD_MS).toFloat() / CURSOR_PERIOD_MS
+    val breath = 0.65f + 0.35f * kotlin.math.cos(phase * 2f * Math.PI.toFloat())
+    val alpha = (255 * breath).toInt().coerceIn(0, 255)
+    val radius = size / 2f
+    val cx = x + radius
+    // Sit on the text the way an inline image does: bottom just below the baseline.
+    val cy = y - size + size * 0.1f + radius
+
